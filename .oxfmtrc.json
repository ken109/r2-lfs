{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {},
  "sortPackageJson": false,
  "ignorePatterns": ["dist/**", ".wrangler/**", "src/routeTree.gen.ts", "pnpm-lock.yaml", "CHANGELOG.md", ".release-please-manifest.json"]
}
